{
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "suaobracerta.com.br"
                }
            ],
            "destination": "https://www.suaobracerta.com.br/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/((?!assets/.*|.*\\..*).*)",
            "destination": "/index.html"
        }
    ]
}